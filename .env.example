# Bot token from @BotFather (/newbot). NEVER commit the real value.
BOT_TOKEN=
# Numeric supergroup id, e.g. -1001234567890 (see README: "Finding GROUP_ID")
GROUP_ID=
# Comma-separated numeric Telegram user ids allowed to use admin commands + dashboard, e.g. 11111111,22222222
ADMIN_TELEGRAM_IDS=
# PostgreSQL connection string, e.g. postgres://user:pass@host:5432/db?sslmode=require
DATABASE_URL=
# Random 32-256 chars, only A-Z a-z 0-9 _ -  (openssl rand -hex 32)
WEBHOOK_SECRET=
# Random 64+ chars (openssl rand -hex 48) - signs admin session cookies
SESSION_SECRET=
# Public https URL of the Koyeb service, no trailing slash, e.g. https://group-premium-you.koyeb.app
BASE_URL=
# Must stay 99 for this product (Stars, integer)
PRICE_STARS=99
# Telegram currently only accepts 2592000 (30 days)
SUBSCRIPTION_PERIOD=2592000
# Random secret for POST /internal/maintenance (openssl rand -hex 32)
MAINTENANCE_SECRET=
# Koyeb injects PORT automatically; 8000 locally
PORT=

# ---- Optional ----
# Public invite link shown on the website "Join Telegram" button
GROUP_INVITE_LINK=
# native (default) | guard   - see README "Photo enforcement modes"
PHOTO_MODE=native
# Set to false only if your Postgres has no TLS (local dev)
DATABASE_SSL=true
